<jasperReport name="reporte_bomberos" language="java" columnCount="1" pageWidth="595" pageHeight="842" columnWidth="555" columnSpacing="10" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1d044804-80a9-49a4-86e1-41a3e930c7ec">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bomberos"/>
	<query language="SQL"><![CDATA[SELECT
    i.id AS id_incidente,
    i.fechaHoraReporte,
    i.fechaHoraInicio,
    i.fechaHoraFin,
    i.descripcion AS descripcion_incidente,
    i.direccion AS direccion_incidente,
    i.estado AS estado_incidente,
    ti.descripcion AS tipo_incidente,
    c.documento AS documento_ciudadano,
    CONCAT(c.nombre, ' ', c.apellido) AS ciudadano,
    c.telefono AS telefono_ciudadano,
    GROUP_CONCAT(DISTINCT CONCAT(b.nombre, ' ', b.apellido) ORDER BY b.apellido, b.nombre SEPARATOR ', ') AS bomberos_asignados
FROM bomberos.incidente i
LEFT JOIN bomberos.tipo_incidente ti ON i.tipo_incidente_id = ti.id
LEFT JOIN bomberos.ciudadano c ON i.ciudadano_id = c.id
LEFT JOIN bomberos.incidente_bombero ib ON i.id = ib.incidente_id
LEFT JOIN bomberos.bombero b ON ib.bombero_id = b.id
GROUP BY
    i.id,
    i.fechaHoraReporte,
    i.fechaHoraInicio,
    i.fechaHoraFin,
    i.descripcion,
    i.direccion,
    i.estado,
    ti.descripcion,
    c.documento,
    c.nombre,
    c.apellido,
    c.telefono
ORDER BY i.fechaHoraReporte DESC
]]></query>
