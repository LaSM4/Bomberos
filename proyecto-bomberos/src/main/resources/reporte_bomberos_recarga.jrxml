<jasperReport name="reporte_bomberos_recarga" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="455c6395-7c48-42f3-a541-7ff7b60e8b1c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bomberos"/>
	<query language="SQL"><![CDATA[SELECT
    rm.id AS id,
    rm.fechaHora AS fecha_hora,
    m.descripcion AS movil,
    CONCAT(b.nombre, ' ', b.apellido) AS bombero,
    COALESCE(td.descripcion, da.direccion, 'Sin depósito') AS deposito_agua,
    rm.cantidadLitros AS cantidad_litros,
    rm.descripcion AS descripcion
FROM recarga_movil rm
INNER JOIN movil m
    ON rm.movil_id = m.id
LEFT JOIN bombero b
    ON rm.bombero_id = b.id
LEFT JOIN deposito_agua da
    ON rm.deposito_agua_id = da.id
LEFT JOIN tipo_deposito td
    ON da.tipo_deposito_id = td.id
ORDER BY rm.fechaHora DESC, rm.id DESC
]]></query>
